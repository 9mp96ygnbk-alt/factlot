{
  "name": "factlot",
  "private": true,
  "description": "FactLot: an open fact layer for commercial real estate AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "packages/schema",
    "packages/id",
    "packages/calc",
    "packages/tools",
    "packages/mcp",
    "packages/reports",
    "packages/server"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --conditions=factlot-source --import ./scripts/test/workers-stub.mjs --test \"packages/*/src/**/*.test.ts\" \"deploy/cloudflare/src/**/*.test.ts\" \"deploy/registry/src/**/*.test.ts\" \"scripts/site/*.test.ts\" \"scripts/ops/*.test.ts\" \"scripts/conformance/*.test.ts\"",
    "test:e2e": "node --experimental-strip-types --test-reporter=spec scripts/e2e/run.ts",
    "build": "npm run build --workspaces",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "schemas": "node --experimental-strip-types --conditions=factlot-source scripts/gen-schemas.ts && prettier --write spec/schemas >/dev/null && rm -rf python/src/factlot/schemas && cp -r spec/schemas python/src/factlot/schemas",
    "schemas:check": "npm run schemas && git diff --exit-code spec/schemas python/src/factlot/schemas",
    "test:python": "cd python && PYTHONPATH=src python3 -m unittest discover -s tests",
    "differential": "npm run build && spec/differential/run.sh",
    "test:bench": "python3 -m unittest discover -s bench -p \"test_*.py\"",
    "build:mcpb": "node --experimental-strip-types --conditions=factlot-source scripts/build-mcpb.ts",
    "test:connectors": "python3 -m unittest discover -s connectors/amazon/bedrock-agent-lambda -p \"test_*.py\"",
    "build:site": "node scripts/site/build.mjs",
    "deploy:cloudflare": "npm run build && npm run build:site && node scripts/site/indexnow.mjs save && cd deploy/cloudflare && npx -y wrangler@4 deploy && cd ../.. && node scripts/site/indexnow.mjs ping",
    "pack:registry": "node --experimental-strip-types --conditions=factlot-source scripts/registry/pack.ts",
    "deploy:registry": "npm run build && node --experimental-strip-types scripts/registry/deploy.ts",
    "sync:registry": "node --experimental-strip-types scripts/registry/sync_pack.ts",
    "ops:usage": "node --experimental-strip-types scripts/ops/usage.mjs",
    "test:hosted": "node --experimental-strip-types scripts/e2e/hosted.ts",
    "test:connectors:live": "node --experimental-strip-types --conditions=factlot-source scripts/conformance/live.ts"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "unpdf": "1.9.1"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "minimatch": "^11.0.1"
  }
}
