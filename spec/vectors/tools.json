{
  "spec": "factlot-tools",
  "description": "Tool-level behaviour every SDK and server must share: run_tool(name, arguments) results and error names.",
  "cases": [
    {
      "tool": "id_parcel",
      "arguments": {
        "state_fips": "06",
        "county_fips": "037",
        "apn": "5432-001-012"
      },
      "expect": {
        "urn": "fl:parcel:us-06037:5432001012",
        "kind": "parcel"
      }
    },
    {
      "tool": "id_entity",
      "arguments": {
        "jurisdiction": "us-de",
        "registry_number": "7654-321"
      },
      "expect": {
        "urn": "fl:entity:us-de:7654321"
      }
    },
    {
      "tool": "id_space",
      "arguments": {
        "building_urn": "fl:building:01jbx3k8q2v7m9c4t6w8y0a2b4",
        "suite": "STE. 400"
      },
      "expect": {
        "urn": "fl:space:01jbx3k8q2v7m9c4t6w8y0a2b4:400"
      }
    },
    {
      "tool": "id_building",
      "arguments": {
        "state_fips": "11",
        "county_fips": "001",
        "zip": "20002",
        "street": "208 Massachusetts Avenue NE, Unit 4"
      },
      "expect": {
        "urn": "fl:building:us-11001:20002:208-massachusetts-ave-ne",
        "kind": "building",
        "short": "flb_nmqcnj0ba3d65ywy5j94bz0h"
      }
    },
    {
      "tool": "id_space",
      "arguments": {
        "building_urn": "fl:building:us-11001:20002:208-massachusetts-ave-ne",
        "suite": "Suite 1-20"
      },
      "expect": {
        "urn": "fl:space:us-11001:20002:208-massachusetts-ave-ne:1-20"
      }
    },
    {
      "tool": "id_document",
      "arguments": {
        "content_base64": "bGVhc2UgdGV4dA=="
      },
      "expect": {
        "urn": "fl:document:sha256-28f0fee39d03764c5294e915f4bd7dcb54e3a1042a21050096898da4cac1119f"
      }
    },
    {
      "tool": "id_parse",
      "arguments": {
        "urn": "fl:parcel:us-48201:0420150000012"
      },
      "expect": {
        "kind": "parcel",
        "parts": ["us-48201", "0420150000012"]
      }
    },
    {
      "tool": "fact_validate",
      "arguments": {
        "fact": {
          "subject": "fl:parcel:us-06037:1",
          "predicate": "parcel.zoning_district",
          "value": "M2",
          "as_of": "2026-11-02",
          "provenance": {
            "method": "public_record",
            "sources": [
              {
                "document_id": "zimas"
              }
            ]
          }
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "tool": "fact_validate",
      "arguments": {
        "fact": {
          "subject": "fl:parcel:us-06037:1",
          "predicate": "parcel.zoning_district",
          "value": "M2",
          "as_of": "2026-11-02",
          "provenance": {
            "method": "extracted",
            "sources": []
          }
        }
      },
      "expect": {
        "valid": false
      }
    },
    {
      "tool": "calc_percentage_rent",
      "arguments": {
        "gross_sales": 5000000,
        "rate": 0.06,
        "base_rent_annual": 240000
      },
      "expect": {
        "value.percentage_rent": 60000,
        "provenance.formula": "calc.percentage_rent@1",
        "provenance.method": "computed"
      }
    },
