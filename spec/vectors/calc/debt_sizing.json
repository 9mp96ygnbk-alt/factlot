    {
      "name": "a rate shock that makes the rate negative is an input error",
      "input": {
        "noi": 2450000,
        "value": 38000000,
        "rate_annual": 0.0875,
        "amortization_years": 0,
        "max_ltv": 0.72,
        "min_dscr": 1.15,
        "min_debt_yield": 0.085,
