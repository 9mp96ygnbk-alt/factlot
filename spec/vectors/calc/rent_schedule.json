{
  "calculator": "calc.rent_schedule",
  "version": 1,
  "cases": [
    {
      "name": "3% annual bumps, 3 months abated",
      "input": {
        "commencement_date": "2026-01-01",
        "term_months": 60,
        "area_sf": 10000,
        "starting_rent_psf_annual": 30,
        "escalation": {
          "type": "percent",
          "rate": 0.03
        },
        "abated_months": [1, 2, 3]
      },
      "expect": {
        "value.expiration_date": "2030-12-31",
        "value.steps.0.monthly_rent": 25000,
        "value.steps.0.abated_months": 3,
        "value.steps.1.monthly_rent": 25750,
        "value.steps.2.monthly_rent": 26522.5,
        "value.steps.3.monthly_rent": 27318.18,
        "value.steps.4.monthly_rent": 28137.72,
        "value.total_scheduled_rent": 1592740.8,
        "value.total_abatement": 75000,
        "value.total_rent_due": 1517740.8
      }
    },
    {
      "name": "fixed $/SF bumps",
      "input": {
        "commencement_date": "2026-03-01",
        "term_months": 24,
        "area_sf": 1000,
        "starting_rent_psf_annual": 20,
        "escalation": {
          "type": "fixed_psf",
          "amount": 1
        }
      },
      "expect": {
        "value.expiration_date": "2028-02-29",
        "value.steps.0.monthly_rent": 1666.67,
        "value.steps.1.monthly_rent": 1750,
        "value.total_rent_due": 41000.04
      }
    },
    {
      "name": "month-end commencement clamps without drifting",
      "input": {
        "commencement_date": "2026-01-31",
        "term_months": 12,
        "area_sf": 1200,
        "starting_rent_psf_annual": 24,
        "include_monthly": true
      },
      "expect": {
        "value.expiration_date": "2027-01-30",
        "value.monthly.1.start_date": "2026-02-28",
        "value.monthly.2.start_date": "2026-03-31",
        "value.monthly.0.end_date": "2026-02-27",
        "value.total_rent_due": 28800
      }
    },
    {
      "name": "rounding strips float noise: 95.58 × 245,051 ÷ 12 = 1,951,831.215 → .22",
      "input": {
        "commencement_date": "2026-01-01",
        "term_months": 100,
        "area_sf": 245051,
        "starting_rent_psf_annual": 95.58
      },
      "expect": {
        "value.steps.0.monthly_rent": 1951831.22,
        "value.total_rent_due": 195183122
      }
    },
    {
      "name": "mid-month commencement warns that months run from the 15th without calendar proration",
      "input": {
        "commencement_date": "2023-03-15",
        "term_months": 60,
        "area_sf": 3000,
        "starting_rent_psf_annual": 14.5,
        "escalation": {
          "type": "fixed_psf",
          "amount": 0.5
        }
      },
      "expect": {
        "value.expiration_date": "2028-03-14",
        "value.steps.1.start_date": "2024-03-15",
        "value.steps.0.monthly_rent": 3625,
        "value.steps.4.monthly_rent": 4125,
        "value.total_rent_due": 232500,
        "warnings": [
          "Commencement 2023-03-15 is mid-month: each lease month runs from day 15 to the day before it in the next month (clamped to month end), and rent is not prorated to calendar months; if rent is billed by calendar month, the first and last partial months need proration outside this result."
        ]
      }
    },
    {
      "name": "abated month beyond term is an input error",
      "input": {
        "commencement_date": "2026-01-01",
        "term_months": 12,
        "area_sf": 1000,
        "starting_rent_psf_annual": 20,
        "abated_months": [13]
      },
      "expect_error": true
    },
    {
      "name": "impossible date is an input error",
      "input": {
        "commencement_date": "2026-02-30",
        "term_months": 12,
        "area_sf": 1000,
        "starting_rent_psf_annual": 20
      },
      "expect_error": true
    },
    {
      "name": "unit kw: the same numbers as square feet, labelled $/kW/yr",
      "input": {
        "commencement_date": "2026-01-01",
        "term_months": 60,
        "area_sf": 10000,
        "starting_rent_psf_annual": 30,
        "escalation": {
          "type": "percent",
          "rate": 0.03
        },
        "abated_months": [1, 2, 3],
        "unit": "kw"
      },
      "expect": {
        "value.expiration_date": "2030-12-31",
        "value.steps.0.monthly_rent": 25000,
        "value.steps.0.abated_months": 3,
        "value.steps.1.monthly_rent": 25750,
        "value.steps.2.monthly_rent": 26522.5,
        "value.steps.3.monthly_rent": 27318.18,
        "value.steps.4.monthly_rent": 28137.72,
        "value.total_scheduled_rent": 1592740.8,
        "value.total_abatement": 75000,
        "value.total_rent_due": 1517740.8,
        "value.unit": "kw",
        "value.rate_unit": "USD/kW/yr",
        "warnings": [
          "Escalated $/SF rates are not rounded per step; set round_rate_to_cents if the lease table rounds.",
          "Unit is kw: area_sf was read as kW and every *_psf rate as $/kW/yr; results are in USD/kW/yr. Field names keep _sf and _psf. Data-center rents are often quoted per kW per month: starting_rent_psf_annual must be annual (monthly × 12). Power, cooling (PUE) and other pass-throughs are not priced unless added as costs."
        ]
      }
    },
    {
      "name": "unit sf given explicitly: the same numbers, plus unit and rate_unit",
      "input": {
        "commencement_date": "2026-03-01",
        "term_months": 24,
        "area_sf": 1000,
        "starting_rent_psf_annual": 20,
        "escalation": {
          "type": "fixed_psf",
          "amount": 1
        },
        "unit": "sf"
      },
      "expect": {
        "value.expiration_date": "2028-02-29",
        "value.steps.0.monthly_rent": 1666.67,
        "value.steps.1.monthly_rent": 1750,
        "value.total_rent_due": 41000.04,
        "value.unit": "sf",
        "value.rate_unit": "USD/sf/yr",
        "warnings": []
      }
    },
    {
      "name": "an unknown unit is an input error",
      "input": {
        "commencement_date": "2026-03-01",
        "term_months": 24,
        "area_sf": 1000,
        "starting_rent_psf_annual": 20,
        "escalation": {
          "type": "fixed_psf",
          "amount": 1
        },
        "unit": "sqm"
      },
      "expect_error": true
    }
  ]
}
