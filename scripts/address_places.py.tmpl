"""The counties a city or ZIP code lies in: from registry parcel labels, and from the US Census Bureau's files.

Generated by scripts/gen-address-places.py from spec/registry/address-places.tsv, zip-counties.tsv and
census-place-counties.tsv; do not edit. Each lookup reads only the line it needs (one label row, one state's places,
the ZIP codes of one two-digit prefix), as the TypeScript table does.
"""

from __future__ import annotations

# Where the Census tables come from (``PLACE_COUNTIES_SOURCE`` in TypeScript).
PLACE_COUNTIES_SOURCE = @SOURCE@

_LABELS = @LABELS@
_ZIPS = @ZIPS@
_PLACES = @PLACES@
_FIPS = {@FIPS@}

# Lines of _ZIPS and _PLACES decoded so far: at most 100 and 52.
_zip_lines: dict[str, dict[str, list[str]]] = {}
_place_lines: dict[str, dict[str, list[str]]] = {}


def _line_after(table: str, head: str) -> str | None:
    at = table.find(head)
    if at < 0:
        return None
    start = at + len(head)
    end = table.find("\n", start)
    return table[start:] if end < 0 else table[start:end]


def _label_row(state: str, place: str) -> tuple[list[str] | None, list[str]] | None:
    line = _line_after(_LABELS, f"\n{state}\t{place}\t")
    if line is None:
        return None
    kept, rest = line.split("\t")
    return (kept.split(" ") if kept else None, rest.split(" ") if rest else [])


def label_place_counties(state: str, place: str) -> list[str] | None:
    """The counties holding at least 3 and 5% of the parcels whose registry label names a city or ZIP code in a
    state, or None (``labelPlaceCounties`` in TypeScript)."""
    row = _label_row(state, place)
    return row[0] if row else None


def label_any_counties(state: str, place: str) -> list[str] | None:
    """Every county holding any parcel whose registry label names a city or ZIP code in a state, however few, or
    None (``labelAnyCounties`` in TypeScript)."""
    row = _label_row(state, place)
    return sorted((row[0] or []) + row[1]) if row else None


def zip_counties(zip5: str) -> list[str] | None:
    """The counties (5-digit FIPS) a ZIP Code Tabulation Area lies in, or None (``zipCounties`` in TypeScript)."""
    if not (len(zip5) == 5 and zip5.isascii() and zip5.isdigit()):
        return None
    head = zip5[:2]
    zips = _zip_lines.get(head)
    if zips is None:
        zips = {}
        line = _line_after(_ZIPS, f"\n{head}=")
        z, counties = int(head) * 1000, []
        for item in line.split(",") if line else []:
            step, _, tail = item.partition(":")
            z += int(step)
            if tail:
                counties = tail.split(" ")
            zips[str(z).zfill(5)] = counties
        _zip_lines[head] = zips
    return zips.get(zip5)


def zip_prefix_states(zip5: str) -> list[str]:
    """The states of the ZIP Code Tabulation Areas sharing a ZIP code's first three digits, in code order
    (``zipPrefixStates`` in TypeScript): where a ZIP code that is no ZCTA (one building's, a post office box's) lies."""
    if zip_counties(zip5) is None and not (len(zip5) == 5 and zip5.isascii() and zip5.isdigit()):
        return []
    out = {st for z, counties in _zip_lines.get(zip5[:2], {}).items() if z.startswith(zip5[:3])
           for c in counties for st, f in _FIPS.items() if c.startswith(f)}
    return sorted(out)


def census_place_counties(state: str, city: str) -> list[str] | None:
    """The counties (5-digit FIPS) the Census places of that name in a state lie in, or None
    (``censusPlaceCounties`` in TypeScript)."""
    if state not in _FIPS:
        return None
    places = _place_lines.get(state)
    if places is None:
        places = {}
        line = _line_after(_PLACES, f"\n{state}=")
        for item in line.split("|") if line else []:
            name, _, codes = item.rpartition(":")
            places[name] = [_FIPS[state] + c for c in codes.split(" ")]
        _place_lines[state] = places
    return places.get(city)


def place_states(city: str) -> list[str]:
    """The states with a Census place of that name or a registry label city of it, in code order
    (``placeStates`` in TypeScript)."""
    out: set[str] = set()
    for sep in ("=", "|"):
        find = f"{sep}{city}:"
        at = _PLACES.find(find)
        while at >= 0:
            line = _PLACES.rfind("\n", 0, at) + 1
            out.add(_PLACES[line:line + 2])
            at = _PLACES.find(find, at + 1)
    find = f"\t{city}\t"
    at = _LABELS.find(find)
    while at >= 0:
        st = _LABELS[at - 2:at]
        if _LABELS[at - 3] == "\n" and label_place_counties(st, city):
            out.add(st)
        at = _LABELS.find(find, at + 1)
    return sorted(out)


def place_counties(state: str, place: str) -> list[str] | None:
    """The counties (5-digit FIPS) a city or ZIP code lies in, in a state, from the Census tables and the registry's
    labels together, or None when neither knows it (``placeCounties`` in TypeScript). A ZIP code's counties outside
    the state are left out."""
    label = label_place_counties(state, place) or []
    if len(place) == 5 and place.isascii() and place.isdigit():
        census = [c for c in (zip_counties(place) or []) if c.startswith(_FIPS.get(state, "--"))]
    else:
        census = census_place_counties(state, place) or []
    return sorted(set(label) | set(census)) or None
