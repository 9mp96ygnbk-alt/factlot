"""The counties a city or ZIP code lies in: from registry parcel labels, and from the US Census Bureau's files.

Generated by scripts/gen-address-places.py from spec/registry/address-places.tsv, zip-counties.tsv and
census-place-counties.tsv; do not edit.
"""

from __future__ import annotations

# Where the Census tables come from (``PLACE_COUNTIES_SOURCE`` in TypeScript).
PLACE_COUNTIES_SOURCE = @SOURCE@

_LABELS = @LABELS@
_ZIPS = @ZIPS@
_PLACES = @PLACES@
_FIPS = {@FIPS@}

_labels: dict[str, list[str]] | None = None
_zips: dict[str, list[str]] | None = None
_places: dict[str, list[str]] | None = None
_states_of: dict[str, list[str]] = {}


def label_place_counties(state: str, place: str) -> list[str] | None:
    """The counties holding a city's or ZIP code's parcels in a state in the registry's labels, or None
    (``labelPlaceCounties`` in TypeScript)."""
    global _labels
    if _labels is None:
        _labels = {}
        for line in _LABELS.split("\n"):
            st, key, counties = line.split("\t")
            _labels[f"{st}|{key}"] = counties.split(" ")
    return _labels.get(f"{state}|{place}")


def zip_counties(zip5: str) -> list[str] | None:
    """The counties (5-digit FIPS) a ZIP Code Tabulation Area lies in, or None (``zipCounties`` in TypeScript)."""
    global _zips
    if _zips is None:
        _zips = {}
        z, counties = 0, []
        for item in _ZIPS.split(","):
            head, _, tail = item.partition(":")
            z += int(head)
            if tail:
                counties = tail.split(" ")
            _zips[str(z).zfill(5)] = counties
    return _zips.get(zip5)


def _place_table() -> dict[str, list[str]]:
    global _places
    if _places is None:
        _places = {}
        for line in _PLACES.split("\n"):
            st = line[:2]
            for item in line[3:].split("|"):
                name, _, codes = item.rpartition(":")
                _places[f"{st}|{name}"] = [_FIPS[st] + c for c in codes.split(" ")]
                _states_of.setdefault(name, []).append(st)
    return _places


def census_place_counties(state: str, city: str) -> list[str] | None:
    """The counties (5-digit FIPS) the Census places of that name in a state lie in, or None
    (``censusPlaceCounties`` in TypeScript)."""
    return _place_table().get(f"{state}|{city}")


def place_states(city: str) -> list[str]:
    """The states with a Census place of that name or a registry label city of it, in code order
    (``placeStates`` in TypeScript)."""
    _place_table()
    out = set(_states_of.get(city, []))
    out.update(st for st in _FIPS if label_place_counties(st, city))
    return sorted(out)


def place_counties(state: str, place: str) -> list[str] | None:
    """The counties (5-digit FIPS) a city or ZIP code lies in, in a state, from the Census tables and the registry's
    labels together, or None when neither knows it (``placeCounties`` in TypeScript). A ZIP code's counties outside
    the state are left out."""
    label = label_place_counties(state, place) or []
    if len(place) == 5 and place.isascii() and place.isdigit():
        census = [c for c in (zip_counties(place) or []) if c.startswith(_FIPS.get(state, "--"))]
    else:
        census = census_place_counties(state, place) or []
    return sorted(set(label) | set(census)) or None
