// Generated by scripts/gen-address-places.py from spec/registry/address-places.tsv, zip-counties.tsv and
// census-place-counties.tsv; do not edit.
// The counties a city or ZIP code lies in: from registry parcel labels, and from the US Census Bureau's files.
// Each lookup reads only the line it needs (one label row, one state's places, the ZIP codes of one two-digit
// prefix), so the first search of an isolate does not decode whole tables.

/** Where the Census tables come from (`PLACE_COUNTIES_SOURCE` in Python). */
export const PLACE_COUNTIES_SOURCE = @SOURCE@;

// Rows after a newline each, ending with one: state, city or ZIP code, the space-separated 5-digit county FIPS codes
// holding at least 3 and 5% of its labelled parcels, and the other counties holding any of them, tab-separated
// (either list may be empty).
const LABELS = @LABELS@;
// One line per first two digits, after a newline: "NN=" and the ZCTAs beginning so, ascending, comma-separated:
// the difference from the one before (the first from NN000), and ":" with its counties when they change.
const ZIPS = @ZIPS@;
// One line per state, after a newline: "STATE=" and "|"-separated places, each "NAME:" and its 3-digit county codes.
const PLACES = @PLACES@;
const FIPS: Record<string, string> = { @FIPS@ };

/** Lines of ZIPS and PLACES decoded so far: at most 100 and 52, so bounded. */
const zipLines = new Map<string, Map<string, string[]>>();
const placeLines = new Map<string, Map<string, string[]>>();

/** The text after `head` up to the end of its line in `table`, or null (`head` starts with a newline). */
function lineAfter(table: string, head: string): string | null {
  const at = table.indexOf(head);
  if (at < 0) return null;
  const start = at + head.length;
  const end = table.indexOf("\n", start);
  return table.slice(start, end < 0 ? table.length : end);
}

function labelRow(
  state: string,
  place: string,
): [string[] | null, string[]] | null {
  const line = lineAfter(LABELS, `\n${state}\t${place}\t`);
  if (line === null) return null;
  const [kept, rest] = line.split("\t");
  return [kept ? kept.split(" ") : null, rest ? rest.split(" ") : []];
}

/**
 * The counties holding at least 3 and 5% of the parcels whose registry label names a city or ZIP code in a state, or
 * null (`label_place_counties` in Python).
 */
export function labelPlaceCounties(
  state: string,
  place: string,
): string[] | null {
  return labelRow(state, place)?.[0] ?? null;
}

/**
 * Every county holding any parcel whose registry label names a city or ZIP code in a state, however few, or null
 * (`label_any_counties` in Python).
 */
export function labelAnyCounties(
  state: string,
  place: string,
): string[] | null {
  const row = labelRow(state, place);
  return row ? [...(row[0] ?? []), ...row[1]].sort() : null;
}

/** The counties (5-digit FIPS) a ZIP Code Tabulation Area lies in, or null (`zip_counties` in Python). */
export function zipCounties(zip: string): string[] | null {
  if (!/^[0-9]{5}$/.test(zip)) return null;
  const head = zip.slice(0, 2);
  let zips = zipLines.get(head);
  if (!zips) {
    zips = new Map();
    const line = lineAfter(ZIPS, `\n${head}=`);
    let z = Number(head) * 1000;
    let counties: string[] = [];
    if (line)
      for (const item of line.split(",")) {
        const at = item.indexOf(":");
        z += Number(at < 0 ? item : item.slice(0, at));
        if (at >= 0) counties = item.slice(at + 1).split(" ");
        zips.set(String(z).padStart(5, "0"), counties);
      }
    zipLines.set(head, zips);
  }
  return zips.get(zip) ?? null;
}

/**
 * The states of the ZIP Code Tabulation Areas sharing a ZIP code's first three digits, in code order
 * (`zip_prefix_states` in Python): where a ZIP code that is no ZCTA (one building's, a post office box's) lies.
 */
export function zipPrefixStates(zip: string): string[] {
  if (zipCounties(zip) === null && !/^[0-9]{5}$/.test(zip)) return [];
  const out = new Set<string>();
  for (const [z, counties] of zipLines.get(zip.slice(0, 2)) ?? [])
    if (z.startsWith(zip.slice(0, 3)))
      for (const c of counties)
        for (const [st, f] of Object.entries(FIPS))
          if (c.startsWith(f)) out.add(st);
  return [...out].sort();
}

/** The counties (5-digit FIPS) the Census places of that name in a state lie in, or null (`census_place_counties` in Python). */
export function censusPlaceCounties(
  state: string,
  city: string,
): string[] | null {
  if (!Object.hasOwn(FIPS, state)) return null;
  let places = placeLines.get(state);
  if (!places) {
    places = new Map();
    const line = lineAfter(PLACES, `\n${state}=`);
    if (line)
      for (const item of line.split("|")) {
        const at = item.lastIndexOf(":");
        places.set(
          item.slice(0, at),
          item
            .slice(at + 1)
            .split(" ")
            .map((c) => `${FIPS[state]}${c}`),
        );
      }
    placeLines.set(state, places);
  }
  return places.get(city) ?? null;
}

/** The states with a Census place of that name or a registry label city of it, in code order (`place_states` in Python). */
export function placeStates(city: string): string[] {
  const out = new Set<string>();
  // A place is "=NAME:" or "|NAME:" on its state's line; its state is the line's first two letters.
  for (const sep of ["=", "|"]) {
    const find = `${sep}${city}:`;
    for (
      let at = PLACES.indexOf(find);
      at >= 0;
      at = PLACES.indexOf(find, at + 1)
    ) {
      const line = PLACES.lastIndexOf("\n", at) + 1;
      out.add(PLACES.slice(line, line + 2));
    }
  }
  // A label row is "\nST\tNAME\t"; its city counts with a county of the first kind.
  const find = `\t${city}\t`;
  for (
    let at = LABELS.indexOf(find);
    at >= 0;
    at = LABELS.indexOf(find, at + 1)
  ) {
    const st = LABELS.slice(at - 2, at);
    if (LABELS[at - 3] === "\n" && labelPlaceCounties(st, city)) out.add(st);
  }
  return [...out].sort();
}

/**
 * The counties (5-digit FIPS) a city or ZIP code lies in, in a state, from the Census tables and the registry's
 * labels together, or null when neither knows it (`place_counties` in Python). A ZIP code's counties outside the
 * state are left out.
 */
export function placeCounties(state: string, place: string): string[] | null {
  const label = labelPlaceCounties(state, place) ?? [];
  const census = /^[0-9]{5}$/.test(place)
    ? (zipCounties(place) ?? []).filter((c) =>
        c.startsWith(FIPS[state] ?? "--"),
      )
    : (censusPlaceCounties(state, place) ?? []);
  const all = [...new Set([...label, ...census])].sort();
  return all.length ? all : null;
}
