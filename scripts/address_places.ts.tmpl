// Generated by scripts/gen-address-places.py from spec/registry/address-places.tsv, zip-counties.tsv and
// census-place-counties.tsv; do not edit.
// The counties a city or ZIP code lies in: from registry parcel labels, and from the US Census Bureau's files.

/** Where the Census tables come from (`PLACE_COUNTIES_SOURCE` in Python). */
export const PLACE_COUNTIES_SOURCE = @SOURCE@;

// Lines of state, city or ZIP code, the space-separated 5-digit county FIPS codes holding at least 3 and 5% of its
// labelled parcels, and the other counties holding any of them, tab-separated (either list may be empty).
const LABELS = @LABELS@;
// ZCTAs ascending, comma-separated: the difference from the one before, and ":" with its counties when they change.
const ZIPS = @ZIPS@;
// One line per state: "STATE=" and "|"-separated places, each "NAME:" and its 3-digit county codes.
const PLACES = @PLACES@;
const FIPS: Record<string, string> = { @FIPS@ };

let labels: Map<string, [string[] | null, string[]]> | undefined;
let zips: Map<string, string[]> | undefined;
let places: Map<string, string[]> | undefined;
let statesOf: Map<string, string[]> | undefined;

function labelRow(
  state: string,
  place: string,
): [string[] | null, string[]] | undefined {
  if (!labels) {
    labels = new Map();
    for (const line of LABELS.split("\n")) {
      const [st, key, kept, rest] = line.split("\t");
      labels.set(`${st}|${key}`, [
        kept ? kept.split(" ") : null,
        rest ? rest.split(" ") : [],
      ]);
    }
  }
  return labels.get(`${state}|${place}`);
}

/**
 * The counties holding at least 3 and 5% of the parcels whose registry label names a city or ZIP code in a state, or
 * null (`label_place_counties` in Python).
 */
export function labelPlaceCounties(
  state: string,
  place: string,
): string[] | null {
  return labelRow(state, place)?.[0] ?? null;
}

/**
 * Every county holding any parcel whose registry label names a city or ZIP code in a state, however few, or null
 * (`label_any_counties` in Python).
 */
export function labelAnyCounties(
  state: string,
  place: string,
): string[] | null {
  const row = labelRow(state, place);
  return row ? [...(row[0] ?? []), ...row[1]].sort() : null;
}

/** The counties (5-digit FIPS) a ZIP Code Tabulation Area lies in, or null (`zip_counties` in Python). */
export function zipCounties(zip: string): string[] | null {
  if (!zips) {
    zips = new Map();
    let z = 0;
    let counties: string[] = [];
    for (const item of ZIPS.split(",")) {
      const at = item.indexOf(":");
      z += Number(at < 0 ? item : item.slice(0, at));
      if (at >= 0) counties = item.slice(at + 1).split(" ");
      zips.set(String(z).padStart(5, "0"), counties);
    }
  }
  return zips.get(zip) ?? null;
}

function placeTable(): Map<string, string[]> {
  if (!places) {
    places = new Map();
    statesOf = new Map();
    for (const line of PLACES.split("\n")) {
      const st = line.slice(0, 2);
      for (const item of line.slice(3).split("|")) {
        const at = item.lastIndexOf(":");
        const name = item.slice(0, at);
        places.set(
          `${st}|${name}`,
          item
            .slice(at + 1)
            .split(" ")
            .map((c) => `${FIPS[st]}${c}`),
        );
        const states = statesOf.get(name) ?? [];
        states.push(st);
        statesOf.set(name, states);
      }
    }
  }
  return places;
}

/** The counties (5-digit FIPS) the Census places of that name in a state lie in, or null (`census_place_counties` in Python). */
export function censusPlaceCounties(
  state: string,
  city: string,
): string[] | null {
  return placeTable().get(`${state}|${city}`) ?? null;
}

/** The states with a Census place of that name or a registry label city of it, in code order (`place_states` in Python). */
export function placeStates(city: string): string[] {
  placeTable();
  const out = new Set(statesOf!.get(city) ?? []);
  for (const st of Object.keys(FIPS))
    if (labelPlaceCounties(st, city)) out.add(st);
  return [...out].sort();
}

/**
 * The counties (5-digit FIPS) a city or ZIP code lies in, in a state, from the Census tables and the registry's
 * labels together, or null when neither knows it (`place_counties` in Python). A ZIP code's counties outside the
 * state are left out.
 */
export function placeCounties(state: string, place: string): string[] | null {
  const label = labelPlaceCounties(state, place) ?? [];
  const census = /^[0-9]{5}$/.test(place)
    ? (zipCounties(place) ?? []).filter((c) =>
        c.startsWith(FIPS[state] ?? "--"),
      )
    : (censusPlaceCounties(state, place) ?? []);
  const all = [...new Set([...label, ...census])].sort();
  return all.length ? all : null;
}
