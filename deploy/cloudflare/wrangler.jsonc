// Hosted FactLot: api.factlot.com (MCP, REST, OpenAPI, billing) and the landing page.
// Deploy: npm run deploy:cloudflare (from the repo root). Secrets (set by a maintainer, never in
// this file): STRIPE_SECRET_KEY (required for billing; checkout opens only with a live key),
// STRIPE_WEBHOOK_SECRET (recommended: plan changes, refunds and disputes apply at once),
// IP_HASH_SALT (a long random string, e.g. `openssl rand -hex 32`; salts the hash that names a
// keyless caller's meter, so stored names cannot be traced back to an address. Set it once with
// `npx wrangler@4 secret put IP_HASH_SALT`; changing it restarts that day's free counts).
// RECOVERY_SIGNING_SECRET (a long random string, e.g. `openssl rand -hex 32`; signs the
// lost-key recovery links. Without it, and without the EMAIL binding below, /account says email
// recovery is being set up).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "factlot-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // CPU time per request, in ms. Reports (POST /v1/reports, report_create) build PDF and XLSX
  // files in the Worker; the largest allowed document takes well under a second, and this
  // ceiling keeps a pathological one from running long. A cpu_ms above the free plan's 10 ms
  // needs the Workers Paid plan (the owner is enabling it); deploy this setting only on Paid.
  "limits": { "cpu_ms": 30000 },
  "workers_dev": false,
  "routes": [
    { "pattern": "api.factlot.com", "custom_domain": true },
    { "pattern": "factlot.com", "custom_domain": true },
    { "pattern": "www.factlot.com", "custom_domain": true },
  ],
  "vars": {
    "SITE_URL": "https://factlot.com",
    "API_URL": "https://api.factlot.com",
  },
  "kv_namespaces": [
    { "binding": "KEYS", "id": "c49c4b0d0bd94c52b1d2d474ad499fcb" },
  ],
  // Registry tools answer from the factlot-registry Worker (deploy/registry), reachable only
  // through this binding. Deploy it first: npm run deploy:registry -- <pack dir>.
  "services": [{ "binding": "REGISTRY", "service": "factlot-registry" }],
  // LIMITER: per-minute limits (memory), registry lookup quotas and checkout-session claims
  // (SQLite storage of the same class; no new migration needed).
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "RateLimiterObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiterObject"] }],
  // Email (welcome email after purchase, lost-key recovery links), through Cloudflare Email
  // Service. The owner enables it: onboard factlot.com under Compute > Email Service > Email
  // Sending in the dashboard (it adds the cf-bounce MX, SPF, DKIM and the _dmarc records), set
  // RECOVERY_SIGNING_SECRET, then uncomment this binding and deploy. Sending to customers needs
  // the Workers Paid plan. Until then the Worker skips the welcome email and /account says
  // recovery is being set up, so deploying without it is safe.
  // "send_email": [{ "name": "EMAIL" }],
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "factlot_usage" },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  // Query strings are left out of logs and traces: /billing/success carries a checkout session id.
  "observability": { "enabled": true, "redact_query_string": true },
}
