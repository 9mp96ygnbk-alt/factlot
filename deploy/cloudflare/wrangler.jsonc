// Hosted FactLot: api.factlot.com (MCP, REST, OpenAPI, billing) and the landing page.
// Deploy: npm run deploy:cloudflare (from the repo root). Secrets (set by the founder, never in
// this file): STRIPE_SECRET_KEY (required for billing), STRIPE_WEBHOOK_SECRET (optional).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "factlot-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "api.factlot.com", "custom_domain": true },
    { "pattern": "factlot.com", "custom_domain": true },
    { "pattern": "www.factlot.com", "custom_domain": true },
  ],
  "vars": {
    "SITE_URL": "https://factlot.com",
    "API_URL": "https://api.factlot.com",
  },
  "kv_namespaces": [
    { "binding": "KEYS", "id": "c49c4b0d0bd94c52b1d2d474ad499fcb" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "RateLimiterObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiterObject"] }],
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "factlot_usage" },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": { "enabled": false },
}
